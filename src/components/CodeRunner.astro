---
// Component to add "Run in Playground" buttons to code blocks with "runnable" in figcaption
---

<script is:inline>
  console.log('CodeRunner script loaded!');
  
  // Unicode-safe base64 encoding
  function base64EncodeUnicode(str) {
    return btoa(
      new TextEncoder().encode(str)
        .reduce((data, byte) => data + String.fromCharCode(byte), "")
    );
  }
  
  function initCodeRunners() {
    console.log('initCodeRunners called');
    // Find all Ferret code blocks
    const figures = document.querySelectorAll('.expressive-code');
    
    figures.forEach((figure) => {
      // Check if already has a run button
      if (figure.querySelector('.run-in-playground-btn')) return;
      
      // Check if it's Ferret code
      const pre = figure.querySelector('pre[data-language="ferret"]');
      if (!pre) return;

      // Check if the figcaption/header contains "runnable"
      const figcaption = figure.querySelector('figcaption');
      const headerText = figcaption ? figcaption.textContent || '' : '';

      // If "runnable" not in header, skip
      if (!headerText.toLowerCase().includes('run')) return;
      
      // Extract code from the pre element, preserving line breaks
      // Expressive Code wraps each line in a .ec-line div
      const lines = pre.querySelectorAll('.ec-line');
      const code = Array.from(lines)
        .map(line => {
          const t = line.textContent;
          if (t == '\n') {
            return '';
          }
          return t;
        })
        .join('\n');
      
      if (!code.trim()) return;
      
      // Create the run button
      const button = document.createElement('button');
      button.className = 'run-in-playground-btn';
      button.title = 'Run in Playground';
      button.innerHTML = `
        <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14">
          <path d="M8 5v14l11-7z"></path>
        </svg>
        <span>Run</span>
      `;
      
      // Add click handler
      button.addEventListener('click', () => {
        const files = { 'main.ferr': code };
        const filesBase64 = base64EncodeUnicode(JSON.stringify(files));
        window.open(`/play?files=${encodeURIComponent(filesBase64)}`, '_blank');
      });
      
      // Add button to the copy button's container
      const copyBtn = figure.querySelector('.copy');
      if (copyBtn) {
        copyBtn.parentElement.insertAdjacentElement('afterbegin', button);
      }
      
      console.log('Run button added');
    });
  }
  
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCodeRunners);
  } else {
    initCodeRunners();
  }
  
  document.addEventListener('astro:page-load', initCodeRunners);
</script>

<style is:global>
  .run-in-playground-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 0.8rem;
    margin: 0.6rem 0.5rem;
    position: absolute;
    top: 0;
    font-size: 0.8rem;
    font-weight: 500;
    background: var(--sl-color-accent);
    color: white;
    border: none;
    border-radius: 20px;
    cursor: pointer;
    z-index: 99;
    line-height: 1;
  }
  
  .run-in-playground-btn svg {
    display: block;
    flex-shrink: 0;
  }
  
  .run-in-playground-btn span {
    display: block;
    line-height: 1;
  }
  
  .code-toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 0.5rem 0.75rem;
    background: var(--sl-color-gray-6);
    border-bottom: 1px solid var(--sl-color-hairline-light);
  }
</style>
