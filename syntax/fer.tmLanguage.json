{
  "displayName": "Ferret",
  "name": "ferret",
  "scopeName": "source.fer",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#bytes" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#imports" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#builtins" },
    { "include": "#types" },
    { "include": "#labels" },
    { "include": "#members" },
    { "include": "#calls" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.fer",
          "begin": "///",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.fer" }
          },
          "end": "$"
        },
        {
          "name": "comment.line.double-slash.fer",
          "begin": "//",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.fer" }
          },
          "end": "$"
        },
        {
          "name": "comment.block.fer",
          "begin": "/\\*",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.comment.begin.fer" }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": { "name": "punctuation.definition.comment.end.fer" }
          }
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.fer",
          "begin": "#\\[",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.attribute.begin.fer" }
          },
          "end": "\\]",
          "endCaptures": {
            "0": { "name": "punctuation.definition.attribute.end.fer" }
          },
          "patterns": [
            {
              "name": "entity.other.attribute-name.fer",
              "match": "\\b[A-Za-z_][A-Za-z0-9_]*\\b"
            },
            { "include": "#strings" },
            { "include": "#numbers" }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fer",
          "begin": "\"",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.fer" }
          },
          "end": "\"",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.fer" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.fer",
              "match": "\\\\(?:[\\\\\"'0abfnrtv]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
            }
          ]
        }
      ]
    },
    "bytes": {
      "patterns": [
        {
          "name": "constant.character.byte.fer",
          "begin": "b'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.fer" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.fer" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.fer",
              "match": "\\\\(?:[\\\\\"'0abfnrtv]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
            }
          ]
        }
      ]
    },
    "chars": {
      "patterns": [
        {
          "name": "string.quoted.single.fer",
          "begin": "'",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.fer" }
          },
          "end": "'",
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.fer" }
          },
          "patterns": [
            {
              "name": "constant.character.escape.fer",
              "match": "\\\\(?:[\\\\\"'0abfnrtv]|x[0-9A-Fa-f]{2}|u\\{[0-9A-Fa-f]+\\})"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.fer",
          "match": "\\b(?:0[xX][0-9A-Za-z](?:[0-9A-Za-z]|_[0-9A-Za-z])*|0[oO][0-9A-Za-z](?:[0-9A-Za-z]|_[0-9A-Za-z])*|0[bB][0-9A-Za-z](?:[0-9A-Za-z]|_[0-9A-Za-z])*|[0-9](?:[0-9]|_[0-9])*(?:\\.[0-9](?:[0-9]|_[0-9])*)?(?:[eE][+-]?[0-9](?:[0-9]|_[0-9])*)?i?)\\b"
        }
      ]
    },
    "imports": {
      "patterns": [
        {
          "name": "meta.import.fer",
          "match": "\\b(import)\\b\\s+(\"[^\"]+\"|[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)(?:\\s+\\b(as)\\b\\s+([A-Za-z_][A-Za-z0-9_]*))?\\s*;?",
          "captures": {
            "1": { "name": "keyword.control.import.fer" },
            "2": { "name": "string.quoted.double.fer" },
            "3": { "name": "keyword.control.import.fer" },
            "4": { "name": "entity.name.namespace.fer" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.fer",
          "match": "\\b(unsafe\\s+)?(fn)\\b\\s+((?:[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)::)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.fer" },
            "2": { "name": "storage.type.function.fer" },
            "3": { "name": "entity.name.type.fer" },
            "4": { "name": "entity.name.function.fer" }
          }
        },
        {
          "name": "meta.test.fer",
          "match": "\\b(test)\\b\\s+(\"(?:\\\\.|[^\"\\\\])*\"|[A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.function.fer" },
            "2": { "name": "entity.name.function.fer" }
          }
        },
        {
          "name": "meta.type-declaration.fer",
          "match": "\\b(type)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.fer" },
            "2": { "name": "entity.name.type.fer" }
          }
        },
        {
          "name": "meta.parameter.fer",
          "match": "(?:^|[,(])\\s*(comptime\\s+)?(mut\\s+)?([A-Za-z_][A-Za-z0-9_]*|self)\\s*(:)\\s*([^,\\)]+)",
          "captures": {
            "1": { "name": "storage.modifier.fer" },
            "2": { "name": "storage.modifier.fer" },
            "3": { "name": "variable.parameter.fer" },
            "4": { "name": "punctuation.separator.type.fer" },
            "5": { "name": "storage.type.fer" }
          }
        },
        {
          "name": "meta.self-parameter.fer",
          "match": "(?:^|[,(])\\s*(comptime\\s+)?(mut\\s+)?(?:&\\s*mut\\s*self|&\\s*self|\\*\\s*self|self)\\b",
          "captures": {
            "1": { "name": "storage.modifier.fer" },
            "2": { "name": "storage.modifier.fer" },
            "0": { "name": "variable.language.self.fer" }
          }
        },
        {
          "name": "meta.const.fer",
          "match": "\\b(const)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.fer" },
            "2": { "name": "variable.other.constant.fer" }
          }
        },
        {
          "name": "meta.let.fer",
          "match": "\\b(let)\\b(?:\\s+(mut))?\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.fer" },
            "2": { "name": "storage.modifier.fer" },
            "3": { "name": "variable.other.readwrite.fer" }
          }
        },
        {
          "name": "meta.for-binding.fer",
          "match": "\\b(for)\\b[^|]*\\|\\s*([A-Za-z_][A-Za-z0-9_]*)(?:\\s*,\\s*([A-Za-z_][A-Za-z0-9_]*))?\\s*\\|",
          "captures": {
            "1": { "name": "keyword.control.fer" },
            "2": { "name": "variable.parameter.fer" },
            "3": { "name": "variable.parameter.fer" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.declaration.fer",
          "match": "\\b(?:let|const|fn|test|type)\\b"
        },
        {
          "name": "keyword.control.fer",
          "match": "\\b(?:if|else|match|for|while|break|continue|return|defer|release|catch|panic|lock|unsafe|import|as)\\b"
        },
        {
          "name": "storage.type.fer",
          "match": "\\b(?:struct|interface|enum|union|error)\\b"
        },
        {
          "name": "storage.modifier.fer",
          "match": "\\b(?:mut|comptime|copy|take|move)\\b"
        },
        {
          "name": "keyword.operator.word.fer",
          "match": "\\b(?:is|map|self)\\b"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "constant.language.boolean.fer",
          "match": "\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.fer",
          "match": "\\bnone\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.builtin.fer",
          "match": "\\b(?:bool|char|str|string|void|Self|u8|u16|u32|u64|usize|i8|i16|i32|i64|isize|f32|f64)\\b"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "entity.name.label.fer",
          "match": "(?m)^\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*:(?!:)"
        },
        {
          "name": "meta.jump-label.fer",
          "match": "\\b(?:break|continue)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.label.fer" }
          }
        }
      ]
    },
    "members": {
      "patterns": [
        {
          "name": "variable.other.member.fer",
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)(?!\\s*\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.dot.fer" },
            "2": { "name": "variable.other.member.fer" }
          }
        },
        {
          "name": "meta.static-member.fer",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)(::)([A-Za-z_][A-Za-z0-9_]*)\\b(?!\\s*\\()",
          "captures": {
            "1": { "name": "support.type.fer" },
            "2": { "name": "punctuation.accessor.double-colon.fer" },
            "3": { "name": "variable.other.constant.fer" }
          }
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "name": "meta.scoped-call.fer",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*)(::)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.namespace.fer" },
            "2": { "name": "punctuation.accessor.double-colon.fer" },
            "3": { "name": "entity.name.function.fer" }
          }
        },
        {
          "name": "meta.function-call.fer",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.fer" }
          }
        },
        {
          "name": "meta.method-call.fer",
          "match": "(\\.)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "punctuation.accessor.dot.fer" },
            "2": { "name": "entity.name.function.fer" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.fer",
          "match": "(?:\\+\\+|--|\\+=|-=|\\*=|/=|%=|\\.\\.\\.|\\.\\.=|\\.\\.|\\!\\!|\\?\\?|::|=>|==|!=|<=|>=|&&|\\|\\||[=!?&+\\-*/%<>~^|])"
        },
        {
          "name": "punctuation.section.brackets.begin.fer",
          "match": "[\\[\\(\\{]"
        },
        {
          "name": "punctuation.section.brackets.end.fer",
          "match": "[\\]\\)\\}]"
        },
        {
          "name": "punctuation.separator.fer",
          "match": "[,;:.]"
        }
      ]
    }
  }
}
